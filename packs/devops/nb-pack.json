    "objective_proofs": [ { "proof_type": "pipeline", "strength": "full", "command_match": "/\\b(deploy|docker|kubectl|helm|terraform|vercel|netlify|wrangler|pipeline|serverless|ansible|pulumi|gh\\s+workflow)/i" } ]
  }
}
