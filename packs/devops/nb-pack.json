  "id": "devops",
  "name": "DevOps Pack",
  "description": "Deploy discipline — proves the pipeline is green and the change is reversible before a deploy is called done.",
  "domain": "devops",
  "status": "scaffold",
  "requires_core": ["intent_lock", "evidence_ledger", "harness_score", "review_gate", "done_claim_firewall", "risk_receipt", "state_machine", "artifact_registry", "human_brief"],
  "adds_agents": [],
  "adds_skills": ["pipeline-proof"],
  "adds_workflows": [],
  "produces_artifacts": ["evidence", "decision", "brief"],
  "evidence_required": ["CI/pipeline output (green)", "rollback/revert path noted"],
  "review_gate": "cross_family",
  "approvals_required": ["any production deploy"],
  "state_updates": ["last_evidence", "open_risks"],
  "harness_score_contribution": { "dimensions": ["evidence", "risks"], "note": "Feeds Evidence with pipeline output and surfaces deploy/rollback risk instead of trusting a green button." },
